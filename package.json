{
  "name": "sunny",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted, single-user personal AI agent. iMessage-first.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nitro dev",
    "build": "nitro build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run --project unit --project integration",
    "test:watch": "vitest --project unit --project integration",
    "coverage": "vitest run --project unit --project integration --coverage",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "experiment:thinking": "tsx --env-file-if-exists=.env evals/experiments/thinking-ab.ts",
    "experiment:delivery": "tsx --env-file-if-exists=.env evals/experiments/delivery-ab.ts",
    "db:setup-world": "workflow-postgres-setup",
    "format": "prettier --write \"src/**/*.ts\" \"server/**/*.ts\" \"plugins/**/*.ts\" \"workflows/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "design:lint": "design.md lint DESIGN.md",
    "design:export": "design.md export --format css-tailwind DESIGN.md > app/theme.css",
    "dashboard:typecheck": "tsc -p app/tsconfig.json --noEmit",
    "dashboard:build": "npm run design:lint && vite build",
    "dashboard:dev": "vite",
    "dev:unified": "NITRO_VITE=1 vite --config vite.config.unified.ts"
  },
  "dependencies": {
    "@1password/sdk": "^0.4.0",
    "@ai-sdk/anthropic": "^3.0.84",
    "@base-ui/react": "^1.5.0",
    "@chat-adapter/state-memory": "^4.30.0",
    "@workflow/ai": "^4.1.2",
    "@workflow/world-postgres": "^4.2.0",
    "ai": "^6.0.206",
    "chat": "^4.30.0",
    "chat-adapter-sendblue": "^0.2.0",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "nitro": "^3.0.260610-beta",
    "pg": "^8.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rollup": "^4.62.0",
    "workflow": "^4.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@google/design.md": "0.3.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "agentation": "^3.0.2",
    "autoevals": "^0.0.132",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.8.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.9",
    "vitest-evals": "^0.12.0"
  }
}
