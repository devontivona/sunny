# Sunny — secrets (env-only, never committed; D-PS5).
# Copy to .env for local dev. In prod these come from a hardened systemd
# EnvironmentFile (root-owned 0600), per D-PS6 / credentials D-CR4.

# Anthropic API key for Claude Opus 4.8 (D-PS3). Required.
ANTHROPIC_API_KEY=sk-ant-...

# Sendblue credentials for the iMessage transport (task 1.3).
# From the Sendblue dashboard → API keys, plus your Sendblue phone number.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
# Recommended: signing secret to verify inbound Sendblue webhook deliveries.
SENDBLUE_WEBHOOK_SECRET=

# Optional: override the runtime dir (defaults to ~/.sunny).
# SUNNY_HOME=/home/devon/.sunny

# Optional: Milestone A echo mode — proves the transport round-trip with no LLM.
# SUNNY_ECHO=1

# Optional (DEV ONLY): log inbound/outbound message text. Off by default since
# message bodies are private. Useful for debugging the agent loop.
# SUNNY_LOG_CONTENT=1
