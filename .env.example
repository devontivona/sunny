# Sunny — secrets (env-only, never committed; D-PS5).
# Copy to .env for local dev. In prod these come from a hardened systemd
# EnvironmentFile (root-owned 0600), per D-PS6 / credentials D-CR4.

# Anthropic API key for Claude Sonnet 5 (D-PS3). Required.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres for messages/schedules/state (Drizzle migrations auto-apply on boot).
# README "First-time setup" runs a dedicated sunny-postgres Docker container.
DATABASE_URL=postgres://sunny:sunny@localhost:5544/sunny

# --- Durable workflows (Vercel Workflow DevKit). REQUIRED -------------------
# Without these, durable conversational turns and scheduled jobs do not run.
# World tables are provisioned automatically at startup (or: npm run db:setup-world).
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://sunny:sunny@localhost:5544/sunny

# Sendblue credentials for the iMessage transport (task 1.3).
# From the Sendblue dashboard → API keys, plus your Sendblue phone number.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
# Signing secret to verify inbound Sendblue webhook deliveries. All four SENDBLUE_*
# vars are required for the iMessage transport; with any missing, the service still
# boots with the transport DISABLED (loopback/test mode) and warns loudly.
SENDBLUE_WEBHOOK_SECRET=

# --- Slack DM channel (add-slack-channel). OPTIONAL -------------------------
# Slack app (api.slack.com/apps) installed to the workspace; events URL points at
# https://<public-host>/webhooks/slack. Both vars required to enable the channel;
# unset ⇒ Sunny boots without Slack, exactly as before. To authorize yourself,
# add your Slack member ID (profile → "Copy member ID", e.g. U0123ABCDEF) to
# `owner.identities` in the sunny config alongside your phone/email — identities
# are channel-stable strings, no schema change. Proactive speech (schedules,
# notifications, relays) stays on iMessage; Slack carries only conversations it
# initiates (DM-only in v1 — non-rostered DMs and channel traffic stay silent).
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=

# --- Credentials: 1Password Service Account (credentials D-CR1/4) -----------
# Token for a write-scoped Service Account scoped to a dedicated `Sunny` vault.
# The SDK resolves op://vault/item/field references in the tool layer only —
# values never reach the model (D-CR2). The vault itself is the authorization
# boundary (D-CR3, revised 2026-07-18: write access lets Sunny SAVE credentials
# it generated itself — existing vault secrets still never round-trip through
# the model). Unset → credentialed tools/skills are unavailable.
# Create: 1Password → Developer → Service Accounts; grant read+write on the Sunny
# vault ONLY (Service Accounts cannot read the Private/Shared vaults — that's the
# point). A read-only token still works for everything except the save action.
# In prod this lives in the hardened systemd EnvironmentFile (D-CR4).
# OP_SERVICE_ACCOUNT_TOKEN=

# --- Web dashboard (web-dashboard change) -----------------------------------
# The read-only dashboard's API + SPA are served BY THIS GATEWAY (Nitro) under
# /dashboard — the front end (Vite SPA in app/) is the only separate build.
#
# Signing secret for dashboard session cookies. REQUIRED to enable the dashboard:
# with it set, access uses the iMessage-approval pairing flow (D-WD4). If UNSET,
# the dashboard is DISABLED (default-deny) — unless DASHBOARD_DEV_OPEN=1.
# Generate: `openssl rand -base64 32`.
# DASHBOARD_SESSION_SECRET=
# Local-dev escape hatch: with no session secret set, DASHBOARD_DEV_OPEN=1 serves
# the dashboard WITHOUT a gate. NEVER set this on a tunnel-exposed host.
# DASHBOARD_DEV_OPEN=1
# Public base URL of THIS host (owner-facing approve links, MCP OAuth redirect,
# and outbound media links). There is deliberately NO default: unset, those
# features degrade with a loud warning. Point this hostname at the gateway; the
# dashboard lives under its /dashboard path.
# DASHBOARD_PUBLIC_URL=https://sunny.example.com

# Public short-link origin (short-links + callback-hosting specs). When set, every
# http(s) URL in outbound message text is rewritten to <origin>/s/<hash> at the
# transport seam, and the oauth_callback tool can mint <origin>/cb/<token>
# endpoints. Point this domain at the gateway (see scripts/setup-snny-tunnel.sh).
# Unset ⇒ shortening and callback hosting are OFF (dev/test-safe).
# SHORT_LINK_BASE_URL=https://snny.ai

# Optional: override the runtime dir (defaults to ~/.sunny).
# SUNNY_HOME=/home/devon/.sunny

# Optional: Milestone A echo mode — proves the transport round-trip with no LLM.
# SUNNY_ECHO=1

# Optional (DEV ONLY): log inbound/outbound message text. Off by default since
# message bodies are private. Useful for debugging the agent loop.
# SUNNY_LOG_CONTENT=1

# --- Observability: self-hosted Langfuse (observability change, D-OB7) --------
# Sunny exports OpenTelemetry spans (LLM/tool/step/job activity) over OTLP to a
# self-hosted Langfuse instance — no egress (D-OB1). Stand up the stack with
# deploy/langfuse/docker-compose.yml, then create a project in the Langfuse UI
# and paste its API keys here. With LANGFUSE_PUBLIC_KEY + LANGFUSE_SECRET_KEY
# set, tracing is enabled; unset, Sunny runs with tracing off (no-op exporter).
# LANGFUSE_BASE_URL=http://localhost:3010
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Optional: force tracing off even when keys are present (e.g. during an eval).
# SUNNY_OTEL_DISABLED=1
