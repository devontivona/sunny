# Langfuse stack config (deploy/langfuse/). Copy to `deploy/langfuse/.env`
# (gitignored) and fill in. Variable names follow UPSTREAM's docker-compose
# contract — do not rename. Secrets here secure Langfuse's own
# Postgres/Clickhouse/Redis/minio + auth; they are separate from Sunny's app
# secrets in the repo-root .env.
#
# Generate the cryptographic values:
#   SALT, NEXTAUTH_SECRET     openssl rand -base64 32
#   ENCRYPTION_KEY            openssl rand -hex 32      # MUST be 64 hex chars
#   *_PASSWORD / REDIS_AUTH   openssl rand -base64 24

# Sunny delta: web UI/API port. override.yml binds the UI to all interfaces on
# this port (LAN-reachable on a headless host); backing stores stay loopback.
LANGFUSE_WEB_PORT=3010
# MUST match the host:port you actually browse to (Langfuse auth/callbacks check
# it). On a headless LAN host use the hostname, e.g. http://janeway.local:3010;
# for loopback-only + SSH tunnel, http://localhost:3010.
NEXTAUTH_URL=http://janeway.local:3010
# Sunny delta: do not phone home (upstream defaults this to true).
TELEMETRY_ENABLED=false

SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# Inter-service credentials. NOTE the linkage in upstream's compose: a couple of
# these passwords are referenced in two places that MUST agree, or services fail
# to authenticate:
#   POSTGRES_PASSWORD   must match the password embedded in DATABASE_URL
#   MINIO_ROOT_PASSWORD must match all three LANGFUSE_S3_*_SECRET_ACCESS_KEY
# (CLICKHOUSE_PASSWORD and REDIS_AUTH are each used as a single var — no linkage.)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/postgres
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>

# Headless bootstrap (single-user, self-hosted): create the org/project, a login
# user, and a known API key pair on first boot — no manual UI signup. Only takes
# effect when the resources don't already exist; it never updates them. The
# public/secret keys here are what Sunny exports with (repo-root .env
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY). Do NOT double-quote these values.
#   keys: pk-lf-$(uuidgen) / sk-lf-$(uuidgen)   ·   password: openssl rand -base64 24
LANGFUSE_INIT_ORG_ID=sunny
LANGFUSE_INIT_PROJECT_ID=sunny
LANGFUSE_INIT_PROJECT_NAME=sunny
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=devon@tivona.me
LANGFUSE_INIT_USER_NAME=Devon
LANGFUSE_INIT_USER_PASSWORD=
