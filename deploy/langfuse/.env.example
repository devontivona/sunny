# Langfuse stack secrets (deploy/langfuse/docker-compose.yml). Copy to
# `deploy/langfuse/.env` (gitignored) and fill in. These secure Langfuse's own
# Postgres/Clickhouse/Redis/minio and its auth — separate from Sunny's app
# secrets in the repo-root .env.
#
# Generate the cryptographic values:
#   LANGFUSE_SALT            openssl rand -base64 32
#   LANGFUSE_NEXTAUTH_SECRET openssl rand -base64 32
#   LANGFUSE_ENCRYPTION_KEY  openssl rand -hex 32      # MUST be 64 hex chars
#   LF_* passwords           openssl rand -base64 24

# Langfuse web UI/API port (published on 127.0.0.1 only).
LANGFUSE_WEB_PORT=3010

LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_ENCRYPTION_KEY=

LF_POSTGRES_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_PASSWORD=
LF_MINIO_PASSWORD=

# Headless bootstrap — creates the org/project, a login user, and a known API
# key pair on first boot (no manual UI signup). Copy the public/secret keys into
# the repo-root .env as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
#   keys: pk-lf-$(uuidgen) / sk-lf-$(uuidgen)   ·   password: openssl rand -base64 24
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=devon@tivona.me
LANGFUSE_INIT_USER_PASSWORD=
